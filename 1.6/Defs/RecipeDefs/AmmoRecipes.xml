<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================== STEEL AMMUNITION RECIPE ==================== -->

  <RecipeDef>
    <defName>Make_Steel_Ammunition</defName>
    <label>make steel ammunition x25</label>
    <description>Craft standardized steel ammunition from raw steel.</description>
    <jobString>Manufacturing steel ammunition.</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <targetCountAdjustment>25</targetCountAdjustment>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Ammunition_Steel>25</Ammunition_Steel>
    </products>
  </RecipeDef>

