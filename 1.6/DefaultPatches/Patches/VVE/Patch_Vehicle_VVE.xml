<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Vehicles Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- Highwayman: Steel to Ammunition_Steel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="Highwayman_MainTurret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Steel</li>
            </thingDefs>
          </value>
        </li>

        <!-- Roadkill: Steel to Ammunition_Steel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="Roadkill_MainTurret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Steel</li>
            </thingDefs>
          </value>
        </li>

        <!-- Bulldog: Steel to Ammunition_Steel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="Bulldog_MainTurret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Steel</li>
            </thingDefs>
          </value>
        </li>

        <!-- Tango: Steel to Ammunition_Steel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="Tango_MainTurret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Steel</li>
            </thingDefs>
          </value>
        </li>

        <!-- Bunsen: Chemfuel to Ammunition_Chemfuel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="VVE_Bunsen_MainTurret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Chemfuel</li>
            </thingDefs>
          </value>
        </li>

        <!-- Scytheman: Chemfuel to Ammunition_Chemfuel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="Scytheman_MainTurret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Chemfuel</li>
            </thingDefs>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
