<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimThunder - Time Forward</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- T14_2A82_Turret: Steel to Ammunition_Steel -->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/Vehicles.VehicleTurretDef[defName="T14_2A82_Turret"]/ammunition/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Ammunition_Steel</li>
            </thingDefs>
          </value>
        </li>

        <!-- RT_HCBT_NG_Turret: Steel to Ammunition_Steel -->
