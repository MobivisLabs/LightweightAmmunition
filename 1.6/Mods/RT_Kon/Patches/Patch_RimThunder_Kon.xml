<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>Mobivis.LightweightAmmunition</modId>
    <key>EnableRTKonTurrets</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationFindMod">
        <mods>
          <li>RimThunder - Kon'</li>
        </mods>
        <match Class="PatchOperationSequence">
          <operations>

            <!-- RT_VDV_32V01Turret: Steel to Ammunition_Steel -->
            <li Class="PatchOperationReplace">
              <xpath>/Defs/Vehicles.VehicleTurretDef[defName="RT_VDV_32V01Turret"]/ammunition/thingDefs</xpath>
              <value>
                <thingDefs>
                  <li>Ammunition_Steel</li>
                </thingDefs>
              </value>
            </li>

            <!-- RT_VDV_32V01BTurret: Steel to Ammunition_Steel -->
            <li Class="PatchOperationReplace">
              <xpath>/Defs/Vehicles.VehicleTurretDef[defName="RT_VDV_32V01BTurret"]/ammunition/thingDefs</xpath>
              <value>
                <thingDefs>
                  <li>Ammunition_Steel</li>
                </thingDefs>
              </value>
            </li>

            <!-- RT_VDV_Kornet_Turret: Chemfuel to Ammunition_Chemfuel -->
            <li Class="PatchOperationReplace">
              <xpath>/Defs/Vehicles.VehicleTurretDef[defName="RT_VDV_Kornet_Turret"]/ammunition/thingDefs</xpath>
              <value>
                <thingDefs>
                  <li>Ammunition_Chemfuel</li>
                </thingDefs>
              </value>
            </li>

            <!-- RT_VDV_AGS30_Turret: Chemfuel to Ammunition_Chemfuel -->
            <li Class="PatchOperationReplace">
              <xpath>/Defs/Vehicles.VehicleTurretDef[defName="RT_VDV_AGS30_Turret"]/ammunition/thingDefs</xpath>
              <value>
                <thingDefs>
                  <li>Ammunition_Chemfuel</li>
                </thingDefs>
              </value>
            </li>

          </operations>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

</Patch>
