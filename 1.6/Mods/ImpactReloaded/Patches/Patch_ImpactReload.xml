<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>Mobivis.LightweightAmmunition</modId>
    <key>EnableImpactReload</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationFindMod">
        <mods>
          <li>Impact Weaponry - Reloaded</li>
        </mods>
        <match Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="DV_Turret_Impact"]</xpath>
          <match MayRequire="detvisor.impactweaponryreloaded" Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="DV_Turret_Impact"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs/li[text()="Steel"]</xpath>
            <value>
              <li>Ammunition_Steel</li>
            </value>
          </match>
        </match>
      </Operation>
    </caseTrue>
  </Operation>

</Patch>
