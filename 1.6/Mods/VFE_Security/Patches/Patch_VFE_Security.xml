                <fuelFilter>
                  <thingDefs>
                    <li>Ammunition_Steel</li>
                  </thingDefs>
                </fuelFilter>
              </value>
            </li>

            <!-- VFES_Turret_MilitaryTurret: Steel to Ammunition_Steel -->
