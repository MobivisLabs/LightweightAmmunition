<?xml version="1.0" encoding="utf-8"?>

<Patch>

  <Operation Class="XmlExtensions.OptionalPatch">
    <modId>Mobivis.LightweightAmmunition</modId>
    <key>EnableVFESecurity</key>
    <defaultValue>true</defaultValue>
    <caseTrue>
      <Operation Class="PatchOperationFindMod">
        <mods>
          <li>Vanilla Furniture Expanded - Security</li>
        </mods>
        <match Class="PatchOperationSequence">
          <operations>

            <!-- VFES_Turret_AntiAir: Steel to Ammunition_Steel -->
            <li MayRequire="VanillaExpanded.VFESecurity" Class="PatchOperationReplace">
              <xpath>/Defs/ThingDef[defName="VFES_Turret_AntiAir"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter</xpath>
              <value>
                <fuelFilter>
                  <thingDefs>
                    <li>Ammunition_Steel</li>
                  </thingDefs>
                </fuelFilter>
              </value>
            </li>

            <!-- VFES_Turret_Concealed: Steel to Ammunition_Steel -->
