                    <li Class="XmlExtensions.Setting.Group">
                        <tag>RTColdFrontTag</tag>
                        <settings>
                        </settings>
                    </li>

                    <!-- RimThunder - Kon' -->
                    <li Class="XmlExtensions.Setting.Group">
                        <tag>RTKonTag</tag>
